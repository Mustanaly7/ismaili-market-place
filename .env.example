# ---------------------------------------------------------------------------
# ISMAILI Market Place - environment configuration
# Copy this file to `.env` and adjust values for your machine.
# ---------------------------------------------------------------------------

# Public base URL of the app (used for links in emails/SEO metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string (docker-compose maps it to host port 5433 so it
# does not clash with a locally installed PostgreSQL already using 5432).
DATABASE_URL=postgres://ismaili:ismaili@localhost:5433/ismaili

# Redis (sessions + lightweight cache). Optional: falls back to in-memory.
REDIS_URL=redis://localhost:6379

# Secret used to sign session tokens. CHANGE THIS IN PRODUCTION.
SESSION_SECRET=dev-only-change-me-please-0123456789abcdef

# S3-compatible object storage. Optional.
# Leave S3_ENDPOINT and S3_ACCESS_KEY empty to store uploads on local disk
# (public/uploads). To use S3/MinIO, fill these in and point them at your
# bucket. Note: MinIO's images are no longer on Docker Hub.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ismaili-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Cloudinary image hosting. Optional but recommended when deploying to a
# read-only filesystem (e.g. Vercel). When set, uploads go to Cloudinary
# instead of local disk / S3. Find these on your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ismaili

# Stripe (test mode). If keys are empty, checkout runs in simulated mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional support contact shown by the persistent "Need help?" button.
NEXT_PUBLIC_SUPPORT_PHONE=+1 555 0100
NEXT_PUBLIC_SUPPORT_WHATSAPP=15550100